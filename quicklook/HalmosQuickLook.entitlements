<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An app extension must be sandboxed or pluginkit will not load it.
	     No file entitlement: Quick Look extends the sandbox to the file
	     being previewed.
	     com.apple.security.network.client is required, not optional: without
	     it the sandbox kills WKWebView's web content process before the page
	     loads, and Quick Look gives up after its backstop. Quick Look still
	     fetches nothing: PreviewViewController installs PreviewText's
	     offlineRules, which block every non-local URL, before the page loads,
	     and refuses to load it if they cannot be installed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
