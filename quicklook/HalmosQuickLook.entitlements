<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An app extension must be sandboxed or pluginkit will not load it.
	     No file entitlement: Quick Look extends the sandbox to the file
	     being previewed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
